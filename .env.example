QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=clinical_notes

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-large

# "mock" (default, offline/deterministic) or "anthropic"
LLM_PROVIDER=mock
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

TOP_K_DENSE=10
TOP_K_BM25=10
TOP_K_RERANK=5

CHUNK_SIZE=300
CHUNK_OVERLAP=50
